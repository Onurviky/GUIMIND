# Copiá este archivo como .env y ajustalo. El .env no se sube a git.

# Carpeta del vault de Obsidian (obligatoria).
VAULT_DIR=F:\segundo cerebro\Memoria IA

# Qué leer del vault, separado por comas. Una carpeta se "monta" en la raíz:
# 02-wiki/casos/X.md queda como casos/X.md. Vacío = todo el vault.
VAULT_INCLUDE=02-wiki, index.md, Cerebro Digital IA.md, log.md

# true = se publican todas las notas leídas, sin exigir `publish: true`.
# Usalo solo si el sitio corre en local o con acceso restringido.
PUBLISH_ALL=true

# Motor del chat "Preguntale al cerebro":
#   ollama     modelo local y gratuito (necesita Ollama abierto y el modelo descargado)
#   anthropic  API de Claude (necesita ANTHROPIC_API_KEY; cada pregunta tiene costo)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b

# Clave de la API de Claude, solo si LLM_PROVIDER=anthropic (console.anthropic.com → API Keys).
# Queda solo en esta computadora; nunca se manda al navegador.
ANTHROPIC_API_KEY=
